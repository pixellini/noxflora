{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
        },
        "jsx": "preserve",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "types": ["node"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.vue",
        "vite.config.ts"
    ]
}
